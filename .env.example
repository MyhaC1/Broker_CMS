# Postgres — поднимается из docker-compose: docker compose up -d db
DATABASE_URL=postgres://cms:cms@localhost:5433/broker_cms

# Секрет Payload (подпись сессий/токенов админки), минимум 32 символа
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Аутентификация контрактного API: сайт шлёт заголовок X-API-Key
CMS_API_KEY=dev-cms-api-key

# Вебхук инвалидации кеша сайта (значение секрета = CMS_WEBHOOK_SECRET на стороне сайта)
SITE_WEBHOOK_URL=http://localhost:3000/api/revalidate
SITE_WEBHOOK_SECRET=dev-webhook-secret

# Публичный origin CMS — для абсолютных URL медиафайлов в контрактных ответах
CMS_PUBLIC_URL=http://localhost:3001

# Первичный администратор (создаётся один раз командой pnpm seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234

# Кнопка Preview в админке → сайт (secret = PREVIEW_SECRET сайта)
SITE_URL=http://localhost:3000
SITE_PREVIEW_SECRET=preview-dev-secret

# Вселенная инструментов MDS (поле выбора символа в разделе Инструменты)
MDS_HTTP_URL=http://localhost:3003
